# ========== LLM 配置 ==========
# 使用 OpenAI 兼容接口（可替换为本地 Ollama 或其他服务）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 如使用 Ollama 本地模型，取消下方注释并填写
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# ========== Embedding 模型配置 ==========
# 模型路径：支持 HuggingFace ID（自动下载）或本地路径
# 中文推荐：BAAI/bge-m3 或 ./models/bge-large-zh-v1.5
# 英文推荐：all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# GPU 设备（cuda 或 cpu）
EMBEDDING_DEVICE=cuda

# ========== 向量数据库后端配置 ==========
# 支持的后端：chroma（默认）, faiss, milvus
# Chroma：需要先启动 chroma 服务（.venv\Scripts\chroma.exe run --path ./chroma_db）
# Faiss：纯内存/本地索引，无需外部服务，适合小规模数据快速验证
# Milvus：高性能分布式向量数据库，适合大规模生产环境
VECTOR_STORE_BACKEND=Milvus

# ========== Chroma 向量数据库（服务模式）==========
# 启动命令：.venv\Scripts\chroma.exe run --path ./chroma_db --host localhost --port 8000
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=rag_documents

# ========== Milvus 向量数据库配置 ==========
# 启动方式：docker run -d --name milvus-standalone -p 19530:19530 -p 9091:9091 milvusdb/milvus:latest
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=rag_documents
MILVUS_DIMENSION=1024
# 索引类型：IVF_FLAT（推荐，适合百万级）, HNSW（高性能，内存消耗大）, FLAT（精确搜索，适合 < 10万）
MILVUS_INDEX_TYPE=IVF_FLAT
# 相似度度量：COSINE（余弦相似度）, IP（内积）, L2（欧氏距离）
MILVUS_METRIC_TYPE=COSINE

# ========== 文档配置 ==========
DOCUMENTS_DIR=./documents

# ========== 检索配置 ==========
# 检索返回的相关文档数量
RETRIEVAL_TOP_K=4
# 混合检索中向量权重（0.0=纯BM25, 1.0=纯向量），推荐 0.5~0.7
HYBRID_SEARCH_ALPHA=0.6
# 文档分块大小（字符数）
CHUNK_SIZE=1000
# 分块重叠大小（字符数）
CHUNK_OVERLAP=50

# ========== 多查询融合检索配置 ==========
# 是否启用多查询融合检索（LLM 生成多个查询变体，合并检索结果）
MULTI_QUERY_ENABLED=true
# 生成的查询变体数量（建议 2~3，太多会增加延迟）
MULTI_QUERY_COUNT=3

# ========== 语义分块配置 ==========
# 是否启用语义分块（基于 Embedding 相似度切分，替代规则分块）
SEMANTIC_CHUNKING_ENABLED=true
# 语义分块相似度分位数阈值（越低切得越细，推荐 85~95）
SEMANTIC_CHUNKING_PERCENTILE=90.0

# ========== Reranker 配置 ==========
# Reranker 模型路径（支持 HuggingFace ID 或本地路径）
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# Reranker 精排后返回的数量（通常与 RETRIEVAL_TOP_K 一致）
RERANKER_TOP_K=4
# Reranker 粗筛候选数：精排前多取一些，确保不漏掉好结果（建议 8~16）
RERANKER_CANDIDATE_K=12
# 是否默认启用 Reranker（true=两阶段检索，false=纯混合检索）
RERANKER_ENABLED=true

# ========== 服务器配置 ==========
FLASK_PORT=5000
FLASK_DEBUG=false